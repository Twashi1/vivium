#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer DataBuffer {
    float data[];
} buf;

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    uint width = 1024;
    uint index = y * width + x;

    buf.data[index] *= 2.0;
}
